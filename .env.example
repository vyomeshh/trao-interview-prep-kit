# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_NAME=trao_session

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/trao

# LLM
LLM_PROVIDER=auto
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-3.8-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=auto
OPENROUTER_MAX_MODELS=3
OPENROUTER_MAX_MODELS=6
OPENROUTER_DISCOVERY_TTL_MS=300000
LLM_TIMEOUT_MS=90000
LLM_RETRIES=3
LLM_RETRY_BASE_MS=5000
LLM_THINKING_LEVEL=low
LLM_FALLBACK_MODEL=gemini-3.7-flash
OPENROUTER_TIMEOUT_MS=90000
GEMINI_DISCOVERY_TTL_MS=600000

# Retrieval/security
SCRAPER_MAX_PAGES=6
SCRAPER_MAX_PAGE_BYTES=500000
SCRAPER_TIMEOUT_MS=8000
SCRAPER_MIN_DELAY_MS=500

# Optional additional providers for automatic failover
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TIMEOUT_MS=90000
GROQ_DISCOVERY_TTL_MS=300000

# Optional local, quota-free development provider (install Ollama and pull a model)
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=90000
OLLAMA_DISCOVERY_TTL_MS=30000
